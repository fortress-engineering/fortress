      "version": "0.1.0",
      "requirements": [
        {
          "id": "AF-BOOTSTRAP-GOVERNANCE-0001-R01",
          "statement": "Fortress records its current declared model and accurately reports that it is not certified.",
          "tests": [
            "T-AF-BOOTSTRAP-GOVERNANCE-0001-R01-001",
            "T-AF-BOOTSTRAP-GOVERNANCE-0001-R01-002",
            "T-AF-BOOTSTRAP-GOVERNANCE-0001-R01-003"
          ]
        },
        {
          "id": "AF-BOOTSTRAP-GOVERNANCE-0001-R02",
          "statement": "Fortress deterministically compiles its complete live Module Contract v2 ecosystem into the canonical provenance-preserving CCG with unique identities, compatible capabilities, effective constraints, verification topology, exact input digests, and explicit unsupported semantics.",
          "tests": [
            "T-AF-BOOTSTRAP-GOVERNANCE-0001-R02-001"
          ]
        }
      ]
    },
    {
      "id": "AF-FORTRESS-AUDIT-0001",
      "version": "0.1.0",
      "requirements": [
        {
          "id": "AF-FORTRESS-AUDIT-0001-R01",
          "statement": "The complete Fortress repository audit is modeled as one coherent deterministic intended Feature flow at the root Module scope spanning CLI request interpretation, repository stabilization, CCG compilation, implementation observation, architecture and rule evaluation, and truthful PASS or FAIL classification.",
          "tests": [
            "T-AF-FORTRESS-AUDIT-0001-R01-001",
            "T-AF-FORTRESS-AUDIT-0001-R01-002"
          ]
        }
      ]
    }
  ],
  "behavior": [
    {
