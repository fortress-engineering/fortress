{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:package-manifest",
  "title": "Fortress development package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "product_version", "target", "archive_sha256", "archive_bytes", "source_commit", "source_fingerprint", "files", "build", "compatibility", "runtime", "authenticity", "release_authorization"],
  "properties": {
    "$schema": {"const": "urn:fortress:schema:v1:package-manifest"},
    "schema_version": {"const": 1},
    "product_version": {"type": "string", "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$"},
    "target": {"enum": ["windows-x64", "linux-x64", "macos-arm64"]},
    "archive_sha256": {"$ref": "#/$defs/digest"},
    "archive_bytes": {"type": "integer", "minimum": 22, "maximum": 536870912},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_fingerprint": {"$ref": "#/$defs/digest"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "maxLength": 224, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "build": {"type": "object", "minProperties": 1},
    "compatibility": {"type": "object", "minProperties": 1},
    "runtime": {"type": "object", "minProperties": 1},
    "authenticity": {"const": "UNVERIFIED"},
    "release_authorization": {"const": "NOT_ESTABLISHED"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
