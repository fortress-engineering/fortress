{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:fortress:derived:v1:change-decision"
    },
    "schema_version": {
      "const": 1
    },
    "proposal_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base_state_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_state_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "base_authority_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transition": {
      "$ref": "urn:fortress:derived:v1:transition-analysis"
    },
    "semantic_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 50000
        }
      },
      "required": [
        "state",
        "reasons"
      ]
    },
    "assurance_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 50000
        }
      },
      "required": [
        "state",
        "reasons"
      ]
    },
    "protected_authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 50000
        }
      },
      "required": [
        "state",
        "reasons"
      ]
    },
    "host_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 50000
        }
      },
      "required": [
        "state",
        "reasons"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "proposal_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "base_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "action": {
            "enum": [
              "CREATE",
              "REPLACE",
              "DELETE",
              "MOVE"
            ]
          },
          "class": {
            "enum": [
              "MODULE_INTENT",
              "STANDARD",
              "PROFILE",
              "OWNERSHIP_SCOPE",
              "FINDING_GOVERNANCE",
              "REQUIRED_EVIDENCE",
              "IDENTITY_MIGRATION",
              "ASSESSOR_TRUST",
              "PROVIDER_TRUST",
              "SCHEMA_COMPATIBILITY",
              "PROTECTED_CONFIGURATION",
              "EVIDENCE_SELECTION",
              "EVIDENCE_PUBLICATION",
              "RELEASE_POLICY",
              "UNKNOWN_CONTROL"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "issuer_policy_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "proposal_ref",
          "base_rule",
          "action",
          "class",
          "path",
          "scope",
          "issuer_policy_ref"
        ]
      },
      "maxItems": 50000
    },
    "authorization": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "MISSING",
              "INVALID",
              "UNSUPPORTED",
              "CONFLICTING",
              "UNAVAILABLE",
              "VERIFIED",
              "QUALIFICATION_REQUIRED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "$schema": {
                    "const": "urn:fortress:derived:v1:validated-grant-receipt"
                  },
                  "schema_version": {
                    "const": 1
                  },
                  "assertion": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "proposal_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "base_state_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "candidate_state_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "base_authority_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "policy_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "requirement_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "issuer_policy_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "verifier_ref": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "action": {
                        "enum": [
                          "CREATE",
                          "REPLACE",
                          "DELETE",
                          "MOVE"
                        ]
                      },
                      "class": {
                        "enum": [
                          "MODULE_INTENT",
                          "STANDARD",
                          "PROFILE",
                          "OWNERSHIP_SCOPE",
                          "FINDING_GOVERNANCE",
                          "REQUIRED_EVIDENCE",
                          "IDENTITY_MIGRATION",
                          "ASSESSOR_TRUST",
                          "PROVIDER_TRUST",
                          "SCHEMA_COMPATIBILITY",
                          "PROTECTED_CONFIGURATION",
                          "EVIDENCE_SELECTION",
                          "EVIDENCE_PUBLICATION",
                          "RELEASE_POLICY",
                          "UNKNOWN_CONTROL"
                        ]
                      },
                      "scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "issuer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "expires_at": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "qualification": {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "candidate_state_ref": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "base_evaluator_ref": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "policy_ref": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              "evidence_ref": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              }
                            },
                            "required": [
                              "candidate_state_ref",
                              "base_evaluator_ref",
                              "policy_ref",
                              "evidence_ref"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "proposal_ref",
                      "base_state_ref",
                      "candidate_state_ref",
                      "base_authority_ref",
                      "policy_ref",
                      "requirement_ref",
                      "issuer_policy_ref",
                      "verifier_ref",
                      "action",
                      "class",
                      "scope",
                      "issuer",
                      "expires_at",
                      "qualification"
                    ]
                  },
                  "receipt_semantics": {
                    "const": "PROVENANCE_ONLY_NOT_TRANSFERABLE"
                  }
                },
                "required": [
                  "$schema",
                  "schema_version",
                  "assertion",
                  "receipt_semantics"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "requirement_ref",
          "state",
          "reason",
          "receipt"
        ]
      },
      "maxItems": 50000
    },
    "authorization_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 50000
    },
    "disposition": {
      "enum": [
        "PERMIT",
        "DENY_SUPPORTED_VIOLATION",
        "REQUIRE_AUTHORIZATION",
        "HOLD_REQUIRED_ASSURANCE",
        "UNEVALUATED"
      ]
    },
    "enforced": {
      "type": "boolean"
    },
    "receipt_semantics": {
      "const": "PROVENANCE_ONLY_NOT_TRANSFERABLE"
    },
    "candidate_binding": {
      "anyOf": [
        {
          "$ref": "urn:fortress:derived:v1:conformance-declaration#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_time": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "proposal_ref",
    "base_state_ref",
    "candidate_state_ref",
    "base_authority_ref",
    "policy_ref",
    "transition",
    "semantic_enforcement",
    "assurance_requirements",
    "protected_authority",
    "host_coverage",
    "requirements",
    "authorization",
    "authorization_references",
    "disposition",
    "enforced",
    "receipt_semantics",
    "candidate_binding",
    "evaluation_time"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v1:change-decision"
}
