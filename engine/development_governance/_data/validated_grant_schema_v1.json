{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:fortress:derived:v1:validated-grant-receipt"
    },
    "schema_version": {
      "const": 1
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "base_state_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidate_state_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "base_authority_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "requirement_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "issuer_policy_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verifier_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action": {
          "enum": [
            "CREATE",
            "REPLACE",
            "DELETE",
            "MOVE"
          ]
        },
        "class": {
          "enum": [
            "MODULE_INTENT",
            "STANDARD",
            "PROFILE",
            "OWNERSHIP_SCOPE",
            "FINDING_GOVERNANCE",
            "REQUIRED_EVIDENCE",
            "IDENTITY_MIGRATION",
            "ASSESSOR_TRUST",
            "PROVIDER_TRUST",
            "SCHEMA_COMPATIBILITY",
            "PROTECTED_CONFIGURATION",
            "EVIDENCE_SELECTION",
            "EVIDENCE_PUBLICATION",
            "RELEASE_POLICY",
            "UNKNOWN_CONTROL"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "candidate_state_ref": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "base_evaluator_ref": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "policy_ref": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "evidence_ref": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "candidate_state_ref",
                "base_evaluator_ref",
                "policy_ref",
                "evidence_ref"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposal_ref",
        "base_state_ref",
        "candidate_state_ref",
        "base_authority_ref",
        "policy_ref",
        "requirement_ref",
        "issuer_policy_ref",
        "verifier_ref",
        "action",
        "class",
        "scope",
        "issuer",
        "expires_at",
        "qualification"
      ]
    },
    "receipt_semantics": {
      "const": "PROVENANCE_ONLY_NOT_TRANSFERABLE"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "assertion",
    "receipt_semantics"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v1:validated-grant-receipt"
}
