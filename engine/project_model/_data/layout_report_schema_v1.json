{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:layout-extension-report",
  "title": "Layout extension report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "authority",
    "observation_digest",
    "canonical_module_paths",
    "profiles",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v1:layout-extension-report"
    },
    "schema_version": {
      "const": 1
    },
    "authority": {
      "const": "ANALYSIS_ONLY"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "canonical_module_paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100001,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "digest",
          "ecosystem",
          "marker",
          "applicability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "ecosystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "marker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          },
          "applicability": {
            "enum": [
              "OBSERVED_MARKER",
              "UNESTABLISHED_MARKER"
            ]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "state",
          "profile",
          "role",
          "observation_limitation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "state": {
            "enum": [
              "CLASSIFIED",
              "UNCLASSIFIED",
              "UNSUPPORTED_ENTRY_KIND",
              "UNESTABLISHED_MARKER",
              "NOT_OBSERVED"
            ]
          },
          "profile": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "SOURCE",
                  "CONFIGURATION",
                  "DOCUMENTATION",
                  "TEST",
                  "ASSET"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "observation_limitation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
