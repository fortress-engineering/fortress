{
  "$schema": "urn:fortress:schema:v1:control-layout",
  "schema_version": 1,
  "id": "fortress-control-layout-v1",
  "root": "__fortress",
  "config": "__fortress/.fsconfig",
  "roles": [
    {
      "path": "__fortress/.fsconfig",
      "role": "PROJECT_CONFIGURATION",
      "owner": "project_model",
      "source_binding": "REQUIRED"
    },
    {
      "path": "__fortress/governance/finding_governance.json",
      "role": "FINDING_GOVERNANCE",
      "owner": "finding_model",
      "source_binding": "REQUIRED"
    },
    {
      "path": "__fortress/governance/information_flow_policy.json",
      "role": "GLOBAL_INFORMATION_FLOW_POLICY",
      "owner": "information_flow",
      "source_binding": "REQUIRED"
    },
    {
      "path": "__fortress/evidence/current.json",
      "role": "ASSESSMENT_SELECTION_INDEX",
      "owner": "snapshot_governance",
      "source_binding": "NONRECURSIVE"
    }
  ],
  "manifest_member": {
    "name": "manifest.json",
    "owner": "certification"
  },
  "artifact_registry": [
    {
      "id": "bfg",
      "logical_path": "_info/behavioral_flow_graph.json",
      "owner": "behavioral_semantics",
      "schema_ref": "urn:fortress:derived:v1:behavioral-flow-graph",
      "producer_semantic_version": "1.0.0",
      "storage": "INCLUDED",
      "member_name": "behavioral_flow_graph.json",
      "production_group": "SEMANTIC"
    },
    {
      "id": "ccg",
      "logical_path": "_info/contract_coherency_graph.json",
      "owner": "contract_coherency",
      "schema_ref": "urn:fortress:derived:v1:contract-coherency-graph",
      "producer_semantic_version": "1.0.0",
      "storage": "EXTERNAL_MATERIALIZATION",
      "production_group": "SEMANTIC"
    },
    {
      "id": "certification",
      "logical_path": "_info/certification.json",
      "owner": "certification",
      "schema_ref": "urn:fortress:derived:v1:certification-result",
      "producer_semantic_version": "2.0.0",
      "storage": "INCLUDED",
      "member_name": "certification.json",
      "production_group": "CERTIFICATION"
    },
    {
      "id": "environmental",
      "logical_path": "_info/environmental_analysis.json",
      "owner": "environmental_semantics",
      "schema_ref": "urn:fortress:derived:v1:environmental-analysis",
      "producer_semantic_version": "1.0.0",
      "storage": "INCLUDED",
      "member_name": "environmental_analysis.json",
      "production_group": "SEMANTIC"
