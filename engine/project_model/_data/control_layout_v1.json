      "logical_path": "_info/evidence_graph.json",
      "owner": "certification",
      "schema_ref": "urn:fortress:derived:v2:evidence-graph",
      "producer_semantic_version": "2.0.0",
      "storage": "INCLUDED",
      "member_name": "evidence_graph.json",
      "production_group": "CERTIFICATION"
    },
    {
      "id": "information-flow",
      "logical_path": "_info/information_flow_analysis.json",
      "owner": "information_flow",
      "schema_ref": "urn:fortress:derived:v1:information-flow-analysis",
      "producer_semantic_version": "1.0.0",
      "storage": "EXTERNAL_MATERIALIZATION",
      "production_group": "SEMANTIC"
