{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v4:project-configuration",
  "title": "Fortress project operation, logical ownership, and profile configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "observation_exclusions", "logical_modules", "governance", "assurance_profiles"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v4:project-configuration" },
    "schema_version": { "const": 4 },
    "observation_exclusions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "logical_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "contract", "parent", "bindings"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "parent": { "type": "string", "minLength": 1 },
          "bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/source_binding" } }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_layout", "selected_profiles", "module_overrides"],
      "properties": {
        "default_layout": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "selected_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/profile_reference" } },
        "module_overrides": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/module_override" } },
        "coverage_floor": { "$ref": "#/$defs/coverage_floor" }
      }
    },
    "assurance_profiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profile_reference" } }
  },
  "$defs": {
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["directory", "file"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "module_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "selected_profiles", "assurance_profiles"],
      "properties": {
        "module": { "type": "string", "minLength": 1 },
        "selected_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/profile_reference" } },
        "assurance_profiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profile_reference" } }
      }
    },
    "coverage_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_semantic_functions", "minimum_evaluable_basis_points"],
      "properties": {
        "minimum_semantic_functions": { "type": "integer", "minimum": 0 },
        "minimum_evaluable_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
