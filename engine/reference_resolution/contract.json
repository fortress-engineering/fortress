          "id": "AF-REFERENCE-RESOLUTION-0001-R01",
          "statement": "Reference Resolution deterministically derives one CCG-bound index from stable Module identities to canonical repository-relative current locations without creating a second authored inventory or persisting machine-local paths.",
          "tests": [
            "T-AF-REFERENCE-RESOLUTION-0001-R01-001",
            "T-AF-REFERENCE-RESOLUTION-0001-R01-002",
            "T-AF-REFERENCE-RESOLUTION-0001-R01-003"
          ]
        },
        {
          "id": "AF-REFERENCE-RESOLUTION-0001-R02",
          "statement": "Reference Resolution classifies local, semantic, physical-projection, external, and machine-local references and restricts cross-Module physical paths to explicit authored resolution boundaries or generated projections.",
          "tests": [
            "T-AF-REFERENCE-RESOLUTION-0001-R02-001",
            "T-AF-REFERENCE-RESOLUTION-0001-R02-002",
            "T-AF-REFERENCE-RESOLUTION-0001-R02-003",
            "T-REPO-REFERENCE-001-R01-001",
            "T-REPO-REFERENCE-001-R01-002",
            "T-REPO-REFERENCE-001-R01-003"
          ]
        },
        {
          "id": "AF-REFERENCE-RESOLUTION-0001-R03",
          "statement": "Reference Resolution projects cross-Module Markdown navigation from stable CCG identity, reconciles Rust and Cargo references against stable crate surfaces and registered path boundaries, and produces byte-identical output on repeated derivation.",
          "tests": [
            "T-AF-REFERENCE-RESOLUTION-0001-R03-001",
            "T-AF-REFERENCE-RESOLUTION-0001-R03-002",
            "T-AF-REFERENCE-RESOLUTION-0001-R03-003",
            "T-AF-REFERENCE-RESOLUTION-0001-R03-004"
          ]
        },
        {
          "id": "AF-REFERENCE-RESOLUTION-0001-R04",
          "statement": "Relocation simulation preserves stable identities and semantic relationships for subtree, upward, and downward moves while reporting only affected generated projections, authored resolution boundaries, and pre-existing invalid physical coupling with bounded indexed work.",
          "tests": [
            "T-AF-REFERENCE-RESOLUTION-0001-R04-001",
            "T-AF-REFERENCE-RESOLUTION-0001-R04-002",
            "T-AF-REFERENCE-RESOLUTION-0001-R04-003",
            "T-AF-REFERENCE-RESOLUTION-0001-R04-004",
