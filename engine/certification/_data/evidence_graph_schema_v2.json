{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v2:evidence-graph",
  "title": "Fortress Evidence Graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "subject", "standard", "profile", "nodes", "root_obligations", "coverage", "provenance"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v2:evidence-graph" },
    "schema_version": { "const": 2 },
    "subject": { "$ref": "#/$defs/digest" },
    "standard": { "type": "object", "required": ["id", "edition"], "properties": { "id": { "type": "string" }, "edition": { "type": "string" } } },
    "profile": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "const": 1 } } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "root_obligations": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "observation", "static_proof", "executed_test", "executed_scenario", "trusted_assertion", "defeater", "aggregate"],
      "properties": {
        "authority": { "type": "integer", "minimum": 0 }, "observation": { "type": "integer", "minimum": 0 }, "static_proof": { "type": "integer", "minimum": 0 }, "executed_test": { "type": "integer", "minimum": 0 }, "executed_scenario": { "type": "integer", "minimum": 0 }, "trusted_assertion": { "type": "integer", "minimum": 0 }, "defeater": { "type": "integer", "minimum": 0 }, "aggregate": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "defeater_id": { "type": "string", "pattern": "^defeater:v1:sha256:[0-9a-f]{64}$" },
    "defeater": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "strength", "producer", "producer_semantic_version", "scope", "reason", "detail", "inputs", "retirement_condition"],
      "properties": {
        "id": { "$ref": "#/$defs/defeater_id" },
        "kind": { "enum": ["NO_SEMANTIC_COVERAGE", "PARTIAL_SEMANTIC_COVERAGE", "UNRESOLVED_CALL_PATH", "UNCLASSIFIED_OPERATION", "UNSUPPORTED_CONSTRUCT", "ANALYSER_LIMIT", "EVIDENCE_PROVENANCE_DOUBT", "STALE_INPUT", "AUTHORITY_SUPERSEDED"] },
        "strength": { "enum": ["DEFEATING", "LIMITING"] },
        "producer": { "type": "string", "minLength": 1 },
        "producer_semantic_version": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subject"],
          "properties": {
            "kind": { "enum": ["MODULE", "SYMBOL", "OPERATION_SITE", "SEMANTIC_CLAIM", "ARTIFACT", "OBLIGATION"] },
            "subject": { "type": "string", "minLength": 1 }
          }
        },
        "reason": { "type": "string", "minLength": 1 },
        "detail": { "type": "object", "additionalProperties": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "retirement_condition": { "enum": ["SEMANTIC_COVERAGE_ESTABLISHED", "FULL_SEMANTIC_COVERAGE_ESTABLISHED", "CALL_RESOLVED", "OPERATION_CLASSIFIED", "CONSTRUCT_SUPPORTED", "ANALYSER_SUPPORT_ESTABLISHED", "PRODUCTION_CAPABLE_EVIDENCE_ESTABLISHED", "INPUT_CURRENT", "CURRENT_AUTHORITY_REEVALUATED"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "subject", "result", "inputs", "producer", "producer_semantic_version", "evidence_class", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" },
        "kind": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "result": { "enum": ["PASS", "FAIL", "UNSUPPORTED", "INVALID", "OBSERVED", "ASSERTED"] },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true },
        "producer": { "type": "string", "minLength": 1 },
        "producer_semantic_version": { "type": "string", "minLength": 1 },
        "evidence_class": { "enum": ["AUTHORITY", "OBSERVATION", "STATIC_PROOF", "EXECUTED_TEST", "EXECUTED_SCENARIO", "TRUSTED_ASSERTION", "DEFEATER", "AGGREGATE"] },
        "payload": {}
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_class": { "const": "DEFEATER" } }, "required": ["evidence_class"] },
          "then": { "properties": { "kind": { "const": "defeater" }, "subject": { "$ref": "#/$defs/defeater_id" }, "payload": { "$ref": "#/$defs/defeater" } } }
        }
      ]
    }
  }
}
