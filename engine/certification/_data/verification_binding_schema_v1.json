{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:verification-bindings",
  "title": "Fortress Distributed Verification Bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "bindings"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v1:verification-bindings" },
    "schema_version": { "const": 1 },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation", "tests"],
        "properties": {
          "obligation": { "type": "string", "minLength": 1 },
          "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^T-[A-Z0-9-]+$" } }
        }
      }
    }
  }
}
