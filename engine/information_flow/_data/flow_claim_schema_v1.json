{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "operation",
    "slot",
    "facet",
    "bound",
    "verdict",
    "source_refs",
    "evidence_refs",
    "defeaters",
    "assumptions",
    "reason_codes",
    "defeater_records",
    "findings",
    "coverage",
    "module_id",
    "operation_name",
    "source_names"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^flow_claim:v1:sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "slot": {
      "$ref": "urn:fortress:schema:v2:information-flow-policy#/$defs/slot"
    },
    "facet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "bound": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "verdict": {
      "enum": [
        "SUPPORTED_VIOLATION",
        "NO_SUPPORTED_VIOLATION",
        "NOT_EVALUABLE",
        "NOT_APPLICABLE"
      ]
    },
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "defeaters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "defeater_records": {
      "type": "array",
      "items": {
        "$ref": "urn:fortress:schema:v6:semantic-conformance#/$defs/defeater"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source_ref",
        "context_ref",
        "policy_ref",
        "governed_source_files",
        "parsed_source_files",
        "dependency_symbols",
        "blocking_eligibility",
        "unsupported"
      ],
      "properties": {
        "scope": {
          "const": "EXPLICIT_VALUE_TRANSFERS"
        },
        "source_ref": {
          "type": "string"
        },
        "context_ref": {
          "type": "string"
        },
        "policy_ref": {
          "type": "string"
        },
        "blocking_eligibility": {
          "enum": [
            "BLOCK_SUPPORTED",
            "ADVISORY_ONLY",
            "NOT_EVALUABLE",
            "NOT_APPLICABLE"
          ]
        },
        "governed_source_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parsed_source_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dependency_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "$schema": {
      "const": "urn:fortress:schema:v1:information-flow-claim"
    },
    "schema_version": {
      "const": 1
    },
    "operation_name": {
      "type": "string",
      "minLength": 1
    },
    "source_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:information-flow-claim",
  "title": "Exact-context bounded information-flow claim v1"
}
