  "decision": "QUALIFIED_HYBRID_WITH_EXPLICIT_OPACITY",
  "interpretation": "These are retained exact-source review and deterministic fixture controls, not measured ecosystem effect completeness, independent precision, recall, or a statistical population study.",
  "premise_authority_scope": "The u8 destructor premise is externally established by review of the exact unshadowed fixture and bound to its source/context. PSM final-segment type normalization alone cannot establish primitive identity. The production helper proves only actual unit syntax. Local callback bodies remain unknown until expansion and type authority are retained; the source-derived comparison uses explicit reviewed premises rather than automatic callback certification.",
  "strategies": [
    {
      "id": "AUTHORED",
      "description": "Retained spelling table supplies a proposed bound from direct observed facts and intentionally ignores callbacks, Drop, and configuration; negative controls expose its inadequacy."
    },
    {
      "id": "SOURCE_DERIVED",
      "description": "Reviewed source shapes compose exact callback/Drop premises and reject incompatible source/context; an unqualified producer cannot discharge a claim."
    },
    {
      "id": "QUALIFIED_HYBRID",
      "description": "Installed qualified entries require exact source/version/target/features/type bindings and all evidence premises; every unsupported or insufficient subset remains unknown."
    }
  ],
