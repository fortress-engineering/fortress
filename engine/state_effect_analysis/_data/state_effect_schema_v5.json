{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v5:state-effect-analysis",
  "title": "Fortress State and Effect Analysis v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "semantic_version",
    "project_id",
    "psm_digest",
    "semantic_analysis_digest",
    "state_contract_digest",
    "function_contract_digest",
    "effect_catalog",
    "summaries",
    "violations",
    "direct_effect_counts",
    "transitive_effect_counts",
    "direct_capability_counts",
    "transitive_capability_counts",
    "coverage",
    "unsupported_semantics",
    "operation_summary_catalog_digest"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v5:state-effect-analysis"
    },
    "schema_version": {
      "const": 5
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "psm_digest": {
      "$ref": "#/$defs/digest"
    },
    "semantic_analysis_digest": {
      "$ref": "#/$defs/digest"
    },
    "state_contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "function_contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "effect_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect_descriptor"
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary_with_execution_provenance"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "direct_effect_counts": {
      "$ref": "#/$defs/count_map"
    },
    "transitive_effect_counts": {
      "$ref": "#/$defs/count_map"
    },
    "direct_capability_counts": {
      "$ref": "#/$defs/count_map"
    },
    "transitive_capability_counts": {
      "$ref": "#/$defs/count_map"
    },
    "coverage": {
      "type": "object"
    },
    "unsupported_semantics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation_summary_catalog_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "count_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "effect_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "operation",
        "capability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "state",
            "filesystem",
            "network",
            "process",
            "environment",
            "time",
            "randomness",
            "panic",
            "unsafe",
            "external"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary_with_execution_provenance": {
      "type": "object",
      "required": [
        "effect_evidence",
        "operation_summaries"
      ],
      "properties": {
        "effect_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "operation_site_id",
              "entry_execution_provenance",
              "source_execution_provenance"
            ],
            "properties": {
              "operation_site_id": {
                "type": "string",
                "pattern": "^rust_operation_site:v1:sha256:[0-9a-f]{64}$"
              },
              "entry_execution_provenance": {
                "enum": [
                  "PRODUCTION_CAPABLE",
                  "TEST_ONLY",
                  "UNKNOWN"
                ]
              },
              "source_execution_provenance": {
                "enum": [
                  "PRODUCTION_CAPABLE",
                  "TEST_ONLY",
                  "UNKNOWN"
                ]
              }
            }
          }
        },
        "operation_summaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_site_id",
              "operation",
              "outcome",
              "context",
              "observation_refs"
            ],
            "properties": {
              "operation_site_id": {
                "type": "string",
                "pattern": "^rust_operation_site:v1:sha256:[0-9a-f]{64}$"
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selected_summary_id",
                  "catalog_digest",
                  "authority",
                  "upper_bound",
                  "premise_refs",
                  "assumption_refs",
                  "reasons"
                ],
                "properties": {
                  "selected_summary_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "catalog_digest": {
                    "$ref": "#/$defs/digest"
                  },
                  "authority": {
                    "enum": [
                      null,
                      "OBSERVED",
                      "DERIVED",
                      "ASSUMED",
                      "QUALIFIED"
                    ]
                  },
                  "upper_bound": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "state"
                        ],
                        "properties": {
                          "state": {
                            "const": "UNKNOWN"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "state",
                          "effects"
                        ],
                        "properties": {
                          "state": {
                            "const": "KNOWN"
                          },
                          "effects": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/effect"
                            },
                            "uniqueItems": true
                          }
                        }
                      }
                    ]
                  },
                  "premise_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assumption_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_digest",
                  "version",
                  "target",
                  "features",
                  "type_bindings"
                ],
                "properties": {
                  "source_digest": {
                    "$ref": "#/$defs/context_digest"
                  },
                  "version": {
                    "$ref": "#/$defs/context_string"
                  },
                  "target": {
                    "$ref": "#/$defs/context_string"
                  },
                  "features": {
                    "$ref": "#/$defs/context_strings"
                  },
                  "type_bindings": {
                    "$ref": "#/$defs/context_strings"
                  }
                }
              },
              "observation_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "effect": {
      "enum": [
        "environment.read",
        "environment.write",
        "external_interaction",
        "filesystem.read",
        "filesystem.write",
        "may_panic",
        "network.connect",
        "network.io",
        "network.listen",
        "owned_state_read",
        "owned_state_write",
        "process.spawn",
        "random.read",
        "receiver_state_read",
        "receiver_state_write",
        "time.monotonic_read",
        "time.wall_read",
        "unsafe_execution"
      ]
    },
    "context_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "const": "UNKNOWN" }
      }
    },
    "context_digest": {
      "oneOf": [
        { "$ref": "#/$defs/context_unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "KNOWN" },
            "value": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "context_string": {
      "oneOf": [
        { "$ref": "#/$defs/context_unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "KNOWN" },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "context_strings": {
      "oneOf": [
        { "$ref": "#/$defs/context_unknown" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "KNOWN" },
            "value": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
