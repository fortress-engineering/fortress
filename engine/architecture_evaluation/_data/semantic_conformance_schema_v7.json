{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v7:semantic-conformance",
  "title": "Fortress Module Semantic Conformance v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "semantic_version",
    "project_id",
    "standard_edition",
    "ccg_digest",
    "psm_digest",
    "state_effect_digest",
    "defeaters",
    "modules",
    "dependency_convergence",
    "summary",
    "unsupported_semantics"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v7:semantic-conformance"
    },
    "schema_version": {
      "const": 7
    },
    "semantic_version": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "standard_edition": {
      "type": "string",
      "minLength": 1
    },
    "ccg_digest": {
      "$ref": "#/$defs/digest"
    },
    "psm_digest": {
      "$ref": "#/$defs/digest"
    },
    "state_effect_digest": {
      "$ref": "#/$defs/digest"
    },
    "defeaters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/defeater"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "dependency_convergence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "unsupported_semantics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "defeater_id": {
      "type": "string",
      "pattern": "^defeater:v1:sha256:[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governed_source_files",
        "analysed_source_files",
        "ratio"
      ],
      "properties": {
        "governed_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "analysed_source_files": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)/[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "defeater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "strength",
        "producer",
        "producer_semantic_version",
        "scope",
        "reason",
        "detail",
        "inputs",
        "retirement_condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/defeater_id"
        },
        "kind": {
          "enum": [
            "NO_SEMANTIC_COVERAGE",
            "PARTIAL_SEMANTIC_COVERAGE",
            "UNRESOLVED_CALL_PATH",
            "UNCLASSIFIED_OPERATION",
            "UNSUPPORTED_CONSTRUCT",
            "ANALYSER_LIMIT",
            "EVIDENCE_PROVENANCE_DOUBT",
            "STALE_INPUT",
            "AUTHORITY_SUPERSEDED"
          ]
        },
        "strength": {
          "enum": [
            "DEFEATING",
            "LIMITING"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producer_semantic_version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "subject"
          ],
          "properties": {
            "kind": {
              "enum": [
                "MODULE",
                "SYMBOL",
                "OPERATION_SITE",
                "SEMANTIC_CLAIM",
                "ARTIFACT",
                "OBLIGATION"
              ]
            },
            "subject": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "retirement_condition": {
          "enum": [
            "SEMANTIC_COVERAGE_ESTABLISHED",
            "FULL_SEMANTIC_COVERAGE_ESTABLISHED",
            "CALL_RESOLVED",
            "OPERATION_CLASSIFIED",
            "CONSTRUCT_SUPPORTED",
            "ANALYSER_SUPPORT_ESTABLISHED",
            "PRODUCTION_CAPABLE_EVIDENCE_ESTABLISHED",
            "INPUT_CURRENT",
            "CURRENT_AUTHORITY_REEVALUATED"
          ]
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_kind",
        "target",
        "disposition",
        "authorization",
        "blocking_eligibility",
        "matching_observations",
        "evidence_provenance",
        "coverage",
        "defeater_refs",
        "slot",
        "instance",
        "instance_ref",
        "verdict",
        "supported_partitions",
        "proof_refs",
        "proof_graph",
        "findings",
        "reason_codes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^semantic_claim:v1:sha256:[0-9a-f]{64}$"
        },
        "target_kind": {
          "enum": [
            "CAPABILITY",
            "EFFECT"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "ALLOW",
            "DENY"
          ]
        },
        "authorization": {
          "enum": [
            "AUTHORISED",
            null
          ]
        },
        "blocking_eligibility": {
          "enum": [
            "BLOCK_SUPPORTED",
            "ADVISORY_ONLY",
            "NOT_EVALUABLE",
            null
          ]
        },
        "matching_observations": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_provenance": {
          "$ref": "#/$defs/evidence_provenance"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "defeater_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defeater_id"
          },
          "uniqueItems": true
        },
        "slot": {
          "$ref": "#/$defs/claim_slot"
        },
        "instance": {
          "$ref": "#/$defs/claim_instance"
        },
        "instance_ref": {
          "type": "string",
          "pattern": "^claim_instance:v1:sha256:[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "SUPPORTED_VIOLATION",
            "NO_SUPPORTED_VIOLATION",
            "NOT_EVALUABLE",
            "NOT_APPLICABLE",
            null
          ]
        },
        "supported_partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supported_partition"
          }
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proof_graph": {
          "oneOf": [
            {
              "$ref": "#/$defs/proof_graph"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "disposition": {
              "const": "ALLOW"
            },
            "authorization": {
              "const": "AUTHORISED"
            },
            "verdict": {
              "const": null
            },
            "blocking_eligibility": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "disposition": {
              "const": "DENY"
            },
            "authorization": {
              "const": null
            },
            "verdict": {
              "enum": [
                "SUPPORTED_VIOLATION",
                "NO_SUPPORTED_VIOLATION",
                "NOT_EVALUABLE",
                "NOT_APPLICABLE"
              ]
            },
            "blocking_eligibility": {
              "enum": [
                "BLOCK_SUPPORTED",
                "ADVISORY_ONLY",
                "NOT_EVALUABLE"
              ]
            }
          }
        }
      ]
    },
    "evidence_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_capable_observations",
        "test_only_observations",
        "unknown_observations"
      ],
      "properties": {
        "production_capable_observations": {
          "type": "integer",
          "minimum": 0
        },
        "test_only_observations": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_observations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "contract_path",
        "policy_state",
        "state",
        "conclusions",
        "observations",
        "ungoverned_observations",
        "coverage",
        "defeater_refs",
        "effective_policy"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "contract_path": {
          "type": "string"
        },
        "policy_state": {
          "enum": [
            "DECLARED",
            "UNDECLARED"
          ]
        },
        "state": {
          "enum": [
            "SUPPORTED_VIOLATION",
            "NO_SUPPORTED_VIOLATION",
            "NOT_EVALUABLE",
            "NOT_APPLICABLE"
          ]
        },
        "conclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conclusion"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation_with_execution_provenance"
          }
        },
        "ungoverned_observations": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "defeater_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defeater_id"
          },
          "uniqueItems": true
        },
        "effective_policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/effective_policy"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observation_with_execution_provenance": {
      "type": "object",
      "required": [
        "operation_site_id",
        "entry_execution_provenance",
        "source_execution_provenance"
      ],
      "properties": {
        "operation_site_id": {
          "type": "string",
          "pattern": "^rust_operation_site:v1:sha256:[0-9a-f]{64}$"
        },
        "entry_execution_provenance": {
          "enum": [
            "PRODUCTION_CAPABLE",
            "TEST_ONLY",
            "UNKNOWN"
          ]
        },
        "source_execution_provenance": {
          "enum": [
            "PRODUCTION_CAPABLE",
            "TEST_ONLY",
            "UNKNOWN"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_modules",
        "modules_with_policy",
        "modules_passed",
        "modules_failed",
        "modules_unknown",
        "modules_not_applicable",
        "authored_authorizations",
        "authorizations_with_observed_usage",
        "authorization_observations",
        "evaluative_deny_claims",
        "deny_claims_passed",
        "deny_claims_failed",
        "deny_claims_unknown",
        "deny_claims_not_applicable",
        "supported_observations",
        "governed_observations",
        "ungoverned_observations",
        "analysis_only_observations",
        "forbidden_capability_findings",
        "forbidden_effect_findings",
        "block_supported_findings",
        "advisory_findings",
        "test_only_advisory_claims",
        "unknown_provenance_advisory_claims",
        "not_evaluable_findings",
        "no_semantic_coverage_claims"
      ],
      "properties": {
        "declared_modules": {
          "type": "integer",
          "minimum": 0
        },
        "modules_with_policy": {
          "type": "integer",
          "minimum": 0
        },
        "modules_passed": {
          "type": "integer",
          "minimum": 0
        },
        "modules_failed": {
          "type": "integer",
          "minimum": 0
        },
        "modules_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "modules_not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "authored_authorizations": {
          "type": "integer",
          "minimum": 0
        },
        "authorizations_with_observed_usage": {
          "type": "integer",
          "minimum": 0
        },
        "authorization_observations": {
          "type": "integer",
          "minimum": 0
        },
        "evaluative_deny_claims": {
          "type": "integer",
          "minimum": 0
        },
        "deny_claims_passed": {
          "type": "integer",
          "minimum": 0
        },
        "deny_claims_failed": {
          "type": "integer",
          "minimum": 0
        },
        "deny_claims_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "deny_claims_not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "supported_observations": {
          "type": "integer",
          "minimum": 0
        },
        "governed_observations": {
          "type": "integer",
          "minimum": 0
        },
        "ungoverned_observations": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_only_observations": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_capability_findings": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_effect_findings": {
          "type": "integer",
          "minimum": 0
        },
        "block_supported_findings": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_findings": {
          "type": "integer",
          "minimum": 0
        },
        "test_only_advisory_claims": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_provenance_advisory_claims": {
          "type": "integer",
          "minimum": 0
        },
        "not_evaluable_findings": {
          "type": "integer",
          "minimum": 0
        },
        "no_semantic_coverage_claims": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "claim_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "target_kind",
        "target_id",
        "scope_selector",
        "context_family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim_slot:v1:sha256:[0-9a-f]{64}$"
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "enum": [
            "CAPABILITY",
            "EFFECT"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_selector": {
          "type": "string",
          "minLength": 1
        },
        "context_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot_id",
        "effective_disposition",
        "policy_digest",
        "context_digest",
        "governed_universe_digest",
        "producer_identity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim_instance:v1:sha256:[0-9a-f]{64}$"
        },
        "slot_id": {
          "$ref": "#/$defs/claim_slot/properties/id"
        },
        "effective_disposition": {
          "enum": [
            "ALLOW",
            "DENY"
          ]
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "context_digest": {
          "$ref": "#/$defs/digest"
        },
        "governed_universe_digest": {
          "$ref": "#/$defs/digest"
        },
        "producer_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supported_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_provenance",
        "observation_refs"
      ],
      "properties": {
        "execution_provenance": {
          "enum": [
            "PRODUCTION_CAPABLE",
            "TEST_ONLY",
            "UNKNOWN"
          ]
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^semantic_observation:v1:sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "proof_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "root_node_id",
        "nodes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "root_node_id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proof_expression"
          }
        }
      }
    },
    "proof_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "operator",
        "required_refs",
        "children"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "LEAF",
            "ALL",
            "ANY"
          ]
        },
        "required_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "effective_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_digest",
        "entries",
        "decisions"
      ],
      "properties": {
        "registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effective_policy_entry"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effective_effect_decision"
          }
        }
      }
    },
    "effective_policy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "target",
        "disposition",
        "status",
        "mapped_effects",
        "effective_effects"
      ],
      "properties": {
        "target_kind": {
          "enum": [
            "CAPABILITY",
            "EFFECT"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "ALLOW",
            "DENY"
          ]
        },
        "status": {
          "enum": [
            "ACTIVE",
            "PARTIALLY_OVERRIDDEN",
            "OVERRIDDEN"
          ]
        },
        "mapped_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "effective_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "effective_effect_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "governing_target_kind",
        "governing_target",
        "disposition"
      ],
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "governing_target_kind": {
          "enum": [
            "CAPABILITY",
            "EFFECT",
            null
          ]
        },
        "governing_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "ALLOW",
            "DENY",
            null
          ]
        }
      }
    }
  }
}
