{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:supported-qualification-scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "scope_id",
    "effects",
    "strata",
    "exclusions",
    "promotes_default_blocking",
    "human_validation"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v1:supported-qualification-scope"
    },
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "promotes_default_blocking": {
      "const": false
    },
    "human_validation": {
      "const": "RECOMMENDED_FUTURE_RESEARCH_NOT_PERFORMED"
    }
  }
}
