              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "supported_scope": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "toolchain": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_cases",
        "completed_cases",
        "required_cases",
        "required_passed",
        "mismatches",
