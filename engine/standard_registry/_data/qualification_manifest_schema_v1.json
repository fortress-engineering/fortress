          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distinct_source_sites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "causal_paths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "declared_mutations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exercised_mutations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equal_differentials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equal_metadata_controls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
