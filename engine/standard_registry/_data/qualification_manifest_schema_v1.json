              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "heldout_selection": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "native_source": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "oracle": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "outcomes": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "profiles": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "protocol": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "registry": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
