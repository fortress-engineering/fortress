{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v1:semantic-qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "scope_id",
    "inputs",
    "counts",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:derived:v1:semantic-qualification"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
