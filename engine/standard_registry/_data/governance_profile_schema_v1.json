{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:governance-profiles",
  "title": "Fortress governance and assurance profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profiles"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v1:governance-profiles" },
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "kind", "layout_id", "active_rules", "semantic_scopes", "required_evidence", "conflicts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "enum": ["GOVERNANCE", "ASSURANCE"] },
        "layout_id": { "type": ["string", "null"] },
        "active_rules": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "semantic_scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "required_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "semantic_scope", "evidence_class"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "semantic_scope": { "type": "string", "minLength": 1 },
              "evidence_class": { "type": "string", "minLength": 1 }
            }
          }
        },
        "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
