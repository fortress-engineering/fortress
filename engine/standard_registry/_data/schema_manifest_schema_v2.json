{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v2:schema-manifest",
  "title": "Fortress repository schema registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "schemas"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v2:schema-manifest" },
    "schema_version": { "const": 2 },
    "id": { "const": "fortress-schema-registry-v2" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(engine/[a-z][a-z0-9_]*|cli)(/[a-z][a-z0-9_]*)*/_data/[a-z][a-z0-9_]*\\.json$"
      }
    }
  }
}
