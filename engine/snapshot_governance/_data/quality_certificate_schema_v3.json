{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v3:local-quality-certificate",
  "title": "Fortress control-generation local quality certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "semantic_version", "project", "profile", "claim", "trust", "source", "toolchain", "gates", "artifacts", "audit_json_digest", "certificate_stamp"],
  "properties": {
    "$schema": { "const": "urn:fortress:derived:v3:local-quality-certificate" },
    "schema_version": { "const": 3 },
    "semantic_version": { "const": "quality-certificate-v3.0" },
    "project": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "claim": { "const": "LOCAL_QUALITY_GATES_PASS" },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "tamper_evidence", "authenticity", "limitation"],
      "properties": {
        "level": { "const": "untrusted-local" },
        "tamper_evidence": { "const": "SHA-256" },
        "authenticity": { "const": "UNVERIFIED" },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "file_count", "excluded_self", "excluded_derived_artifacts"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/digest" },
        "file_count": { "type": "integer", "minimum": 1 },
        "excluded_self": { "const": "quality-certificate" },
        "excluded_derived_artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["rust", "cargo_config", "resolver_lockfile", "build_artifacts", "derived_projections"],
      "properties": {
        "rust": { "type": "string", "minLength": 1 },
        "cargo_config": { "type": "string", "minLength": 1 },
        "resolver_lockfile": { "type": "string", "minLength": 1 },
        "build_artifacts": { "type": "string", "minLength": 1 },
        "derived_projections": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "PASS" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "digest", "bytes", "storage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "digest": { "$ref": "#/$defs/digest" },
          "bytes": { "type": "integer", "minimum": 1 },
          "storage": { "enum": ["TRACKED_EVIDENCE", "LOCAL_MATERIALIZATION"] }
        }
      }
    },
    "audit_json_digest": { "$ref": "#/$defs/digest" },
    "certificate_stamp": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
