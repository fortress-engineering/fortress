{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v2:local-quality-certificate",
  "title": "Fortress source-pure local quality certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "semantic_version", "project", "profile", "claim", "trust", "source", "toolchain", "gates", "artifacts", "audit_json_digest", "certificate_stamp"],
  "properties": {
    "$schema": { "const": "urn:fortress:derived:v2:local-quality-certificate" },
    "schema_version": { "const": 2 },
    "semantic_version": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "claim": { "const": "LOCAL_QUALITY_GATES_PASS" },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "tamper_evidence", "authenticity", "limitation"],
      "properties": {
        "level": { "const": "untrusted-local" },
        "tamper_evidence": { "const": "SHA-256" },
        "authenticity": { "const": "UNVERIFIED" },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "file_count", "excluded_self", "excluded_derived_artifacts"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "file_count": { "type": "integer", "minimum": 1 },
        "excluded_self": { "const": "_info/quality_certificate.json" },
        "excluded_derived_artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["rust", "cargo_config", "resolver_lockfile", "build_artifacts", "derived_projections"],
      "properties": {
        "rust": { "type": "string", "minLength": 1 },
        "cargo_config": { "type": "string", "minLength": 1 },
        "resolver_lockfile": { "type": "string", "minLength": 1 },
        "build_artifacts": { "type": "string", "minLength": 1 },
        "derived_projections": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "PASS" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "digest", "bytes", "storage"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "storage": { "enum": ["TRACKED_EVIDENCE", "LOCAL_MATERIALIZATION"] }
        }
      }
    },
    "audit_json_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "certificate_stamp": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
