{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:qualification:v1:performance-equivalence",
  "title": "Source-bound correctness evidence and separate diagnostic observations",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "urn:fortress:qualification:v1:performance-equivalence"
    },
    "schema_version": {
      "const": 1
    },
    "claim": {
      "const": "RECORDED_CORRECTNESS_EVIDENCE_AND_DIAGNOSTICS"
    },
    "source_domain": {
      "const": "QUALITY_CERTIFICATE_SOURCE_FINGERPRINT"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "correctness_certificate": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workload_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_qualification": {
      "type": "object",
      "properties": {
        "independent_comparisons": {
          "const": 300
        },
        "candidate_differential_cases": {
          "const": 1000
        },
        "resident_differential_cases": {
          "const": 1000
        }
      },
      "required": [
        "independent_comparisons",
        "candidate_differential_cases",
        "resident_differential_cases"
      ],
      "additionalProperties": false
    },
    "independent_cold_proof": {
      "const": true
    },
    "unfiltered_required_suite": {
      "const": true
    },
    "numeric_performance_certification": {
      "const": false
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$",
            "maxLength": 128
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        },
        "required": [
          "id",
          "digest",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "authenticity": {
      "const": "UNVERIFIED"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "correctness_evidence": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "populations": {
          "type": "object",
          "properties": {
            "independent_comparisons": {
              "const": 300
            },
            "candidate_differential_cases": {
              "const": 1000
            },
            "resident_differential_cases": {
              "const": 1000
            }
          },
          "required": [
            "independent_comparisons",
            "candidate_differential_cases",
            "resident_differential_cases"
          ],
          "additionalProperties": false
        },
        "unfiltered_suite": {
          "const": true
        },
        "independent_cold": {
          "const": true
        },
        "reports": {
          "type": "object",
          "properties": {
            "independent_comparisons": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "candidate_differential_cases": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "resident_differential_cases": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "independent_comparisons",
            "candidate_differential_cases",
            "resident_differential_cases"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_ref",
        "populations",
        "unfiltered_suite",
        "independent_cold",
        "reports"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "claim",
    "source_domain",
    "source_ref",
    "correctness_certificate",
    "workload_manifest_digest",
    "required_qualification",
    "independent_cold_proof",
    "unfiltered_required_suite",
    "numeric_performance_certification",
    "observations",
    "limitations",
    "authenticity",
    "record_id",
    "correctness_evidence"
  ],
  "additionalProperties": false
}
