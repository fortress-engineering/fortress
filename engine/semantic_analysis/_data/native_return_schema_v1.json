{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:native-function-contracts",
  "title": "Authored native Boolean return requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "functions"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v1:native-function-contracts"
    },
    "schema_version": {
      "const": 1
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "required_return"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^(go_callable_slot|python_lexical_callable_slot):v1:sha256:[0-9a-f]{64}$"
          },
          "required_return": {
            "type": "boolean"
          }
        }
      },
      "$comment": "The owning reader requires sorted unique subject references in JCS with one LF."
    }
  }
}
