{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:proof-graph",
  "title": "Neutral proof graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_node_id", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "root_node_id": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "operator", "required_refs", "children"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["LEAF", "ALL", "ANY"] },
          "required_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "children": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$comment": "ProofGraph.validate additionally enforces canonical ordering, reference resolution, reachability, acyclicity, and nonempty support."
}
