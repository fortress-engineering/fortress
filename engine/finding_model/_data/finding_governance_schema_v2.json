{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v2:finding-governance",
  "title": "Fortress anchored finding governance and retained lifecycle history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "baseline",
    "exceptions",
    "lifecycle"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:schema:v2:finding-governance"
    },
    "schema_version": {
      "const": 2
    },
    "baseline": {
      "oneOf": [
        {
          "$ref": "#/$defs/baseline"
        },
        {
          "type": "null"
        }
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchors",
        "retirements",
        "exception_reviews"
      ],
      "properties": {
        "anchors": {
          "type": "object",
          "maxProperties": 50000,
          "additionalProperties": {
            "$ref": "#/$defs/anchor"
          }
        },
        "retirements": {
          "type": "object",
          "maxProperties": 50000,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_entry",
              "anchor",
              "evidence"
            ],
            "properties": {
              "original_entry": {
                "$ref": "#/$defs/baseline-entry"
              },
              "anchor": {
                "$ref": "#/$defs/anchor"
              },
              "evidence": {
                "$ref": "urn:fortress:derived:v2:retirement-evidence"
              }
            }
          }
        },
        "exception_reviews": {
          "type": "object",
          "maxProperties": 50000,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchor",
              "grant_reference",
              "policy",
              "retirement_reason"
            ],
            "properties": {
              "anchor": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/anchor"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "grant_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "review_at",
                  "expires_at"
                ],
                "properties": {
                  "review_at": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expires_at": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "retirement_reason": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_id",
        "standard_edition",
        "active_entries",
        "retired_entries"
      ],
      "properties": {
        "standard_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id"
        },
        "standard_edition": {
          "type": "string",
          "minLength": 1
        },
        "active_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline-entry"
          }
        },
        "retired_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retired-entry"
          }
        }
      }
    },
    "baseline-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "subjects",
        "violation_discriminator",
        "rationale"
      ],
      "properties": {
        "finding_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/sha256"
        },
        "rule_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/rule-id"
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id"
          }
        },
        "violation_discriminator": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "retired-entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id"
      ],
      "properties": {
        "finding_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/sha256"
        },
        "rule_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/rule-id"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "finding_id",
        "rule_id",
        "authority",
        "rationale",
        "review_condition",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id"
        },
        "finding_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/sha256"
        },
        "rule_id": {
          "$ref": "urn:fortress:schema:v1:common#/$defs/rule-id"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "review_condition": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "ACTIVE",
            "RETIRED"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "from_state",
        "subject_ref",
        "original_authority_ref",
        "meaning_ref",
        "claim_scope_ref",
        "identity_ref",
        "subject_refs"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "from_state": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "original_authority_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "meaning_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claim_scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "identity_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_refs": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
