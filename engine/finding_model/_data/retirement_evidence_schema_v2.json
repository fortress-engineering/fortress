{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v2:retirement-evidence",
  "title": "Fortress comparable retirement evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "finding_id",
    "original_authority_ref",
    "from_subject",
    "to_subject",
    "claim_scope_ref",
    "comparison_basis",
    "outcome",
    "proof_refs",
    "reasons",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:derived:v2:retirement-evidence"
    },
    "schema_version": {
      "const": 2
    },
    "finding_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "original_authority_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "from_subject": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "to_subject": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_scope_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_state",
        "to_state",
        "transition_ref",
        "governance_ref",
        "anchor_ref"
      ],
      "properties": {
        "from_state": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "to_state": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transition_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "governance_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "anchor_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "PRESENT",
        "RESOLVED",
        "SUBJECT_REMOVED",
        "NOT_OBSERVED",
        "POLICY_RETIRED",
        "SCOPE_EXCLUDED",
        "AUTHORITY_INCOMPARABLE",
        "IDENTITY_AMBIGUOUS"
      ]
    },
    "proof_refs": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "RESOLVED",
              "SUBJECT_REMOVED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "original_authority_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "from_subject": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "to_subject": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "claim_scope_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "proof_refs": {
            "minItems": 1
          },
          "comparison_basis": {
            "properties": {
              "anchor_ref": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
