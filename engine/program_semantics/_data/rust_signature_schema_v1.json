{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:rust-signature-catalog",
  "title": "Fortress bounded Rust signature catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "rust_toolchain", "constructors", "builders"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v1:rust-signature-catalog" },
    "schema_version": { "const": 1 },
    "rust_toolchain": { "const": "1.97.1" },
    "constructors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "return_type"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "return_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "builders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "receiver_methods"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "receiver_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
