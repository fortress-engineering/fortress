{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:derived:v2:go-native-build-observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "binding_sha256",
    "response_sha256",
    "provenance",
    "observation",
    "build_context",
    "selection"
  ],
  "properties": {
    "$schema": {
      "const": "urn:fortress:derived:v2:go-native-build-observation"
    },
    "schema_version": {
      "const": 2
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "observation": {
      "$ref": "#/$defs/observation"
    },
    "build_context": {
      "$ref": "#/$defs/build_context"
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/file_selection"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_byte",
        "end_byte",
        "start_line",
        "start_byte_column"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "start_byte_column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65537
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_path",
        "go_version",
        "target_os",
        "target_arch",
        "source_inventory"
      ],
      "properties": {
        "package_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "go_version": {
          "enum": [
            "go1.17",
            "go1.22"
          ]
        },
        "target_os": {
          "enum": [
            "windows",
            "linux"
          ]
        },
        "target_arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "source_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "minItems": 1,
          "maxItems": 64
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "producer",
        "go_toolchain",
        "request_sha256",
        "context_sha256",
        "context",
        "status",
        "diagnostic",
        "package_name",
        "declarations",
        "calls",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "producer": {
          "const": "fortress.go-build-selection@0.1.0"
        },
        "go_toolchain": {
          "$ref": "#/$defs/toolchain"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "status": {
          "enum": [
            "OBSERVED",
            "INVALID_SOURCE",
            "UNSUPPORTED",
            "RESOURCE_LIMIT"
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "span"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "GO_TYPE_CHECK_REJECTED",
                    "GO_OBSERVATION_LIMIT",
                    "GO_UNRESOLVED_DECLARATION",
                    "NO_SELECTED_GO_SOURCE",
                    "NATIVE_SELECTION_ERROR",
                    "GO_PARSE_FAILURE",
                    "GO_AST_LIMIT",
                    "TEST_CONTEXT_REQUIRED",
                    "DUAL_CONSTRAINTS_UNSUPPORTED",
                    "GENERATED_SOURCE_CONTEXT_REQUIRED",
                    "COMPILER_DIRECTIVE_CONTEXT_REQUIRED",
                    "CGO_CONTEXT_UNSUPPORTED",
                    "DEPENDENCY_CONTEXT_REQUIRED",
                    "VIRTUAL_SOURCE_UNAVAILABLE"
                  ]
                },
                "span": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/span"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "package_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "limitations": {
          "const": [
            "HOST_MUST_ESTABLISH_PACKAGE_AND_CONTEXT_COMPLETENESS",
            "FILE_SELECTION_DOES_NOT_ESTABLISH_PACKAGE_OR_BUILD_COMPLETENESS",
            "NO_DEPENDENCIES_FOREIGN_GENERATED_OR_TEST_EXECUTION_CONTEXT",
            "BODYLESS_DECLARATIONS_DO_NOT_ESTABLISH_IMPLEMENTATION",
            "NO_RUNTIME_EFFECT_REACHABILITY_OR_EXECUTION_PROOF",
            "INTERFACE_FUNCTION_VALUE_AND_OTHER_UNSUPPORTED_DISPATCH_REMAINS_UNRESOLVED"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "OBSERVED"
          }
        }
      },
      "then": {
        "properties": {
          "diagnostic": {
            "type": "null"
          },
          "package_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      },
      "else": {
        "properties": {
          "diagnostic": {
            "type": "object"
          },
          "package_name": {
            "type": "null"
          },
          "declarations": {
            "maxItems": 0
          },
          "calls": {
            "maxItems": 0
          }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "name",
        "kind",
        "declared_signature",
        "span"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "SOURCE_BODY",
            "EXTERNAL_BODY_UNOBSERVED"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "kind": {
          "enum": [
            "FUNCTION",
            "METHOD"
          ]
        },
        "declared_signature": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2048
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resolution",
        "activation",
        "span",
        "declaration"
      ],
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "enum": [
            "DIRECT_FUNCTION",
            "DIRECT_METHOD",
            "EXTERNAL_BODY_UNOBSERVED",
            "TYPE_CONVERSION",
            "BUILTIN",
            "UNRESOLVED_CALL_FORM",
            "UNRESOLVED_INTERFACE_DISPATCH",
            "UNRESOLVED_FUNCTION_VALUE",
            "UNRESOLVED_DECLARATION"
          ]
        },
        "activation": {
          "enum": [
            "ORDINARY",
            "GOROUTINE",
            "DEFERRED"
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_view_sha256",
        "source_fingerprint",
        "authority_sha256",
        "actual",
        "package_directory",
        "process",
        "wire_context_sha256",
        "request_sha256"
      ],
      "properties": {
        "kind": {
          "const": "fortress-go-build-observation-input-v2"
        },
        "source_view_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actual": {
          "const": true
        },
        "package_directory": {
          "type": "string",
          "maxLength": 240
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable_sha256",
            "supervisor_context_sha256",
            "go_toolchain"
          ],
          "properties": {
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "supervisor_context_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "go_toolchain": {
              "$ref": "#/$defs/toolchain"
            }
          }
        },
        "wire_context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolchain": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^go1\\.[A-Za-z0-9.]*$"
    },
    "build_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "release_minor",
        "cgo_enabled",
        "test_mode",
        "custom_tags",
        "tool_tags"
      ],
      "properties": {
        "compiler": {
          "const": "gc"
        },
        "release_minor": {
          "type": "integer",
          "minimum": 17,
          "maximum": 22
        },
        "cgo_enabled": {
          "const": false
        },
        "test_mode": {
          "enum": [
            "REQUIRE_SEPARATE_TEST_CONTEXT",
            "PRODUCTION_ONLY"
          ]
        },
        "custom_tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        },
        "tool_tags": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64.v1",
              "amd64.v2",
              "amd64.v3",
              "amd64.v4"
            ]
          }
        }
      }
    },
    "file_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "native_match",
        "disposition"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_match": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "EXCLUDED_BY_NAME_OR_CONSTRAINT",
            "PRODUCTION_TEST_EXCLUDED",
            "SELECTED_GO_SOURCE",
            "NATIVE_SELECTION_ERROR",
            "GO_PARSE_FAILURE",
            "GO_AST_LIMIT",
            "TEST_CONTEXT_REQUIRED",
            "DUAL_CONSTRAINTS_UNSUPPORTED",
            "GENERATED_SOURCE_CONTEXT_REQUIRED",
            "COMPILER_DIRECTIVE_CONTEXT_REQUIRED",
            "CGO_CONTEXT_UNSUPPORTED",
            "DEPENDENCY_CONTEXT_REQUIRED",
            "VIRTUAL_SOURCE_UNAVAILABLE"
          ]
        }
      }
    }
  }
}
