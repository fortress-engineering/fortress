{
  "schema": "fortress-research/python-import-reference-protocol/1",
  "semantics": "Finite source-only file-finder controls for explicit closed ordered roots, ignoring ambient and dynamic runtime state.",
  "expected_basis": [
    "https://docs.python.org/3.12/library/importlib.html",
    "https://docs.python.org/3.13/library/importlib.html",
    "https://peps.python.org/pep-0420/"
  ],
  "limits": {
    "protocol_bytes": 65536,
    "case_count": 40,
    "roots": 4,
    "manifest_files": 64,
    "max_path_bytes": 160,
    "max_source_bytes": 2048,
    "max_statement_bytes": 1024,
    "path_components": 12
  },
  "fixture": {
    "A/ref_pkg/__init__.py": "# owned fixture 0\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_pkg/client.py": "# owned fixture 1\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_pkg/helper.py": "# owned fixture 2\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_pkg/sub/__init__.py": "# owned fixture 3\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_pkg/sub/caller.py": "# owned fixture 4\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_plain.py": "# owned fixture 5\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_ns/left.py": "# owned fixture 6\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "B/ref_ns/right.py": "# owned fixture 7\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_shift/old.py": "# owned fixture 8\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "B/ref_shift/__init__.py": "# owned fixture 9\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "B/ref_shift/live.py": "# owned fixture 10\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_dual.py": "# owned fixture 11\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_dual/__init__.py": "# owned fixture 12\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "A/ref_duplicate.py": "# owned fixture 13\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "B/ref_duplicate.py": "# owned fixture 14\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "C/ref_native.pyd": "# owned fixture 15\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n",
    "C/ref_native.py": "# owned fixture 16\nfrom pathlib import Path\nPath(\"IMPOSSIBLE_IMPORT_SENTINEL\").write_text(\"executed\")\nraise RuntimeError(\"fixture file must never execute\")\n"
  },
  "cases": [
    {
      "id": "regular-package",
      "statement": "import ref_pkg",
      "roots": [
        "A",
        "B"
      ],
      "expected": {
        "state": "FILE_STATIC",
        "absolute": "ref_pkg",
        "paths": [
          "A/ref_pkg/__init__.py"
        ],
        "members": "NONE",
        "runtime": "UNRESOLVED"
      }
    },
    {
      "id": "regular-module",
      "statement": "import ref_plain as p",
      "roots": [
        "A",
        "B"
      ],
      "expected": {
        "state": "FILE_STATIC",
        "absolute": "ref_plain",
        "paths": [
          "A/ref_plain.py"
        ],
        "members": "NONE",
        "runtime": "UNRESOLVED"
      }
    },
    {
