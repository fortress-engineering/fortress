{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:schema-manifest",
  "title": "Fortress schema registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "schemas"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "id": { "const": "fortress-schema-registry-v1" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^v1/[a-z][a-z0-9-]*\\.schema\\.json$" }
    }
  }
}
