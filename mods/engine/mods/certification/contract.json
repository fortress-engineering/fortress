  "features": [
    {
      "id": "AF-CERTIFICATION-0001",
      "version": "0.1.0",
      "requirements": [
        {
          "id": "AF-CERTIFICATION-0001-R01",
          "statement": "Certification constructs and validates an immutable deterministic content-addressed Evidence DAG whose node identities exclude their own IDs, whose dependencies are complete and acyclic, and whose affected closure preserves unrelated evidence.",
          "tests": [
            "T-AF-CERTIFICATION-0001-R01-001",
            "T-AF-CERTIFICATION-0001-R01-002",
            "T-AF-CERTIFICATION-0001-R01-003"
          ]
        },
        {
          "id": "AF-CERTIFICATION-0001-R02",
          "statement": "Certification evaluates the canonical full-snapshot profile with exact INVALID, FAIL, STALE, MISSING, and PASS precedence while unsupported mandatory rule semantics remain missing rather than passing.",
          "tests": [
            "T-AF-CERTIFICATION-0001-R02-001",
            "T-AF-CERTIFICATION-0001-R02-002",
            "T-AF-CERTIFICATION-0001-R02-003"
          ]
        },
        {
          "id": "AF-CERTIFICATION-0001-R03",
          "statement": "Certification derives Requirement and generated-scenario evidence only from a successful current canonical unfiltered eligible Rust suite, validates distributed Testing-boundary bindings, and preserves trusted assertions as a distinct evidence class.",
          "tests": [
            "T-AF-CERTIFICATION-0001-R03-001",
            "T-AF-CERTIFICATION-0001-R03-002",
            "T-AF-CERTIFICATION-0001-R03-003"
          ]
        },
        {
          "id": "AF-CERTIFICATION-0001-R04",
          "statement": "Certification derives a recursion-free source identity from one registered generated-projection exclusion set and deterministically projects Intended and Realized behavior into evidence-aware Verified BFG states without attributing Feature tests to exact edges absent a binding.",
          "tests": [
            "T-AF-CERTIFICATION-0001-R04-001",
            "T-AF-CERTIFICATION-0001-R04-002",
            "T-AF-CERTIFICATION-0001-R04-003"
          ]
        }
      ]
    }
  ],
  "behavior": []
