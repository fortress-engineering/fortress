{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:environment-contracts",
  "title": "Fortress Environment Contracts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "operations"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v1:environment-contracts" },
    "schema_version": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "stable_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
    "symbol": { "type": "string", "pattern": "^rust_symbol:sha256:[0-9a-f]{64}$" },
    "string_list": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "domain": {
      "oneOf": [
        { "$ref": "#/$defs/top" },
        { "$ref": "#/$defs/bottom" },
        { "$ref": "#/$defs/boolean" },
        { "$ref": "#/$defs/integer_interval" },
        { "$ref": "#/$defs/option_states" },
        { "$ref": "#/$defs/result_states" },
        { "$ref": "#/$defs/enum_variants" },
        { "$ref": "#/$defs/tuple" }
      ]
    },
    "top": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "top" } }
    },
    "bottom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "bottom" } }
    },
    "boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "include"],
      "properties": {
        "kind": { "const": "boolean" },
        "include": { "type": "array", "uniqueItems": true, "items": { "type": "boolean" } }
      }
    },
    "integer_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "min", "max", "exclude"],
      "properties": {
        "kind": { "const": "integer_interval" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } }
      }
    },
    "option_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "include", "some"],
      "properties": {
        "kind": { "const": "option_states" },
        "include": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "some"] } },
        "some": { "oneOf": [{ "$ref": "#/$defs/domain" }, { "type": "null" }] }
      }
    },
    "result_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "include", "ok", "err"],
      "properties": {
        "kind": { "const": "result_states" },
        "include": { "type": "array", "uniqueItems": true, "items": { "enum": ["err", "ok"] } },
        "ok": { "oneOf": [{ "$ref": "#/$defs/domain" }, { "type": "null" }] },
        "err": { "oneOf": [{ "$ref": "#/$defs/domain" }, { "type": "null" }] }
      }
    },
    "enum_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "include"],
      "properties": {
        "kind": { "const": "enum_variants" },
        "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "elements"],
      "properties": {
        "kind": { "const": "tuple" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/domain" } }
      }
    },
    "flow_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet", "level"],
      "properties": {
        "facet": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 }
      }
    },
    "handling": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["continuation", "terminal", "retry", "idempotency_key_parameter", "duplicate_strategy"],
      "properties": {
        "continuation": { "$ref": "#/$defs/symbol" },
        "terminal": { "type": "boolean" },
        "retry": { "type": "boolean" },
        "idempotency_key_parameter": { "type": ["string", "null"], "minLength": 1 },
        "duplicate_strategy": { "enum": ["NONE", "IDEMPOTENT_HANDLER", "DEDUPLICATION_KEY", "UNKNOWN"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "completion", "response", "timing", "result", "domain", "information_flow", "state", "forbidden_effects", "resource", "handling"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "completion": { "enum": ["COMPLETED", "NOT_COMPLETED", "UNKNOWN_COMPLETION"] },
        "response": { "enum": ["NO_RESPONSE", "ONE_RESPONSE", "MULTIPLE_RESPONSES"] },
        "timing": { "enum": ["WITHIN_DEADLINE", "AFTER_DEADLINE", "UNBOUNDED"] },
        "result": { "enum": ["SUCCESS", "REJECTED", "FAILURE", "MALFORMED", "RESOURCE_UNAVAILABLE"] },
        "domain": { "oneOf": [{ "$ref": "#/$defs/domain" }, { "type": "null" }] },
        "information_flow": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/flow_label" } },
        "state": { "type": ["string", "null"], "pattern": "^STATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "forbidden_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["receiver_state_read", "receiver_state_write", "owned_state_read", "owned_state_write", "external_interaction", "filesystem.read", "filesystem.write", "network.connect", "network.listen", "network.io", "process.spawn", "environment.read", "environment.write", "time.wall_read", "time.monotonic_read", "random.read", "may_panic", "unsafe_execution"] }
        },
        "resource": { "type": ["string", "null"], "enum": ["memory", "storage", "worker_capacity", "queue_capacity", null] },
        "handling": { "$ref": "#/$defs/handling" }
      }
    },
    "effect_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "durable": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["handler", "permitted_states", "forbidden_states", "restart", "idempotency_key_parameter"],
      "properties": {
        "handler": { "$ref": "#/$defs/symbol" },
        "permitted_states": { "$ref": "#/$defs/string_list" },
        "forbidden_states": { "$ref": "#/$defs/string_list" },
        "restart": { "enum": ["ABORT", "CONTINUE", "RETRY_OPERATION"] },
        "idempotency_key_parameter": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "boundary", "retry_policy", "retryable_outcomes", "idempotency", "idempotency_key_parameter", "delivery", "interruption_sensitive", "atomicity", "effect_steps", "recovery", "outcomes"],
      "properties": {
        "id": { "$ref": "#/$defs/stable_id" },
        "actor": { "type": "string", "minLength": 1 },
        "boundary": { "$ref": "#/$defs/symbol" },
        "retry_policy": { "enum": ["NEVER", "SAFE", "CONDITIONAL", "UNKNOWN"] },
        "retryable_outcomes": { "$ref": "#/$defs/string_list" },
        "idempotency": { "enum": ["IDEMPOTENT", "IDEMPOTENT_WITH_KEY", "NON_IDEMPOTENT", "UNKNOWN"] },
        "idempotency_key_parameter": { "type": ["string", "null"], "minLength": 1 },
        "delivery": { "enum": ["AT_MOST_ONCE", "AT_LEAST_ONCE", "MAY_DUPLICATE"] },
        "interruption_sensitive": { "type": "boolean" },
        "atomicity": { "enum": ["ATOMIC", "NON_ATOMIC", "UNKNOWN"] },
        "effect_steps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/effect_step" } },
        "recovery": { "$ref": "#/$defs/recovery" },
        "outcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/outcome" } }
      }
    }
  }
}
