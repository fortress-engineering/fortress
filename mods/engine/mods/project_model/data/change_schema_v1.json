{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:change",
  "title": "Fortress temporal change and bootstrap record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "objective", "baseline", "authority_refs", "scope", "checks", "decisions", "result"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "$ref": "urn:fortress:schema:v1:common#/$defs/schema-version" },
    "id": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
    "status": { "enum": ["intent", "analyzed", "planned", "authorized", "in-progress", "verifying", "certified", "archived", "blocked", "rejected", "superseded", "cancelled"] },
    "objective": { "$ref": "urn:fortress:schema:v1:common#/$defs/non-empty-string" },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["commit", "branch"], "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "branch": { "type": "string", "minLength": 1 } } },
    "authority_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "bootstrap_provenance": { "type": "object", "additionalProperties": false, "required": ["packet_kind", "digest_kind", "digests"], "properties": { "packet_kind": { "enum": ["archive", "extracted-directory"] }, "archive_digest": { "oneOf": [{ "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" }, { "type": "null" }] }, "digest_kind": { "enum": ["archive-and-files", "files-only"] }, "digests": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" }, "sha256": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" } } } } } },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "promoted_artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source", "target", "disposition"], "properties": { "source": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" }, "target": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" }, "disposition": { "enum": ["promoted-unchanged", "promoted-with-transformation", "encoded", "archived", "discarded"] } } } },
    "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["command", "status"], "properties": { "command": { "type": "string", "minLength": 1 }, "status": { "enum": ["pending", "passed", "failed", "blocked", "not-applicable"] }, "summary": { "type": "string" } } } },
    "decisions": { "type": "array", "items": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" } },
    "deferred_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "result": { "type": "object", "additionalProperties": false, "required": ["certification_claim", "commit"], "properties": { "certification_claim": { "enum": ["CERTIFIED", "NOT CERTIFIED"] }, "commit": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] }, "note": { "type": "string" } } }
  }
}
