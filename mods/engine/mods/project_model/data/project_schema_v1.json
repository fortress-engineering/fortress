{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:project",
  "title": "Fortress project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "standard", "archetypes", "capabilities", "languages", "model"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "$ref": "urn:fortress:schema:v1:common#/$defs/schema-version" },
    "id": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
    "name": { "$ref": "urn:fortress:schema:v1:common#/$defs/non-empty-string" },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edition", "status", "digest", "manifest"],
      "properties": {
        "id": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        "edition": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "candidate", "released"] },
        "digest": { "oneOf": [{ "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" }, { "type": "null" }] },
        "manifest": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" }
      }
    },
    "archetypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" } },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "features", "commands", "certifications", "active_changes", "observation_exclusions"],
      "properties": {
        "architecture": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" },
        "features": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" } },
        "commands": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" },
        "certifications": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" },
        "active_changes": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" } },
        "observation_exclusions": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" } }
      }
    }
  }
}
