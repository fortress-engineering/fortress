{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v3:snapshot-audit",
  "title": "Fortress deterministic snapshot audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "governance", "standard", "snapshot_fingerprint", "repository_content_fingerprint", "outcome", "summary", "rules", "findings", "diagnostics", "unsupported_analysis", "observation"],
  "properties": {
    "schema_version": { "const": 3 },
    "project_id": {
      "oneOf": [
        { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        { "type": "null" }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_authority", "standard_authority", "declared_source_owners", "analysis_source_owners", "observed_tests", "tests_missing_stable_id"],
      "properties": {
        "project_authority": { "enum": ["DECLARED", "ABSENT", "INVALID"] },
        "standard_authority": { "enum": ["PROJECT_BOUND", "INSTALLED_UNBOUND"] },
        "declared_source_owners": { "type": "integer", "minimum": 0 },
        "analysis_source_owners": { "type": "integer", "minimum": 0 },
        "observed_tests": { "type": "integer", "minimum": 0 },
        "tests_missing_stable_id": { "type": "integer", "minimum": 0 }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "status"],
      "properties": {
        "edition": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "candidate", "released"] }
      }
    },
    "snapshot_fingerprint": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" },
    "repository_content_fingerprint": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" },
    "outcome": { "enum": ["PASS", "FAIL", "MISSING"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_evaluated", "passed", "failed", "unsupported"],
      "properties": {
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "state", "applicable", "findings", "detail"],
        "properties": {
          "rule_id": { "$ref": "urn:fortress:schema:v1:common#/$defs/rule-id" },
          "state": { "enum": ["PASSED", "FAILED", "UNSUPPORTED"] },
          "applicable": { "type": "boolean" },
          "findings": { "type": "integer", "minimum": 0 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "urn:fortress:schema:v1:snapshot-finding" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/architecture-diagnostic" }
    },
    "unsupported_analysis": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "rust_sources", "psm_symbols", "source_artifacts", "state_effect_functions"],
          "properties": {
            "files": { "type": "integer", "minimum": 0 },
            "rust_sources": { "type": "integer", "minimum": 0 },
            "psm_symbols": { "type": "integer", "minimum": 0 },
            "source_artifacts": { "type": "integer", "minimum": 0 },
            "state_effect_functions": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "architecture-diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "primary_module", "related_modules", "summary", "reasoning", "declared_evidence", "observed_evidence", "candidate_structural_scope", "provenance", "fingerprint"],
      "properties": {
        "kind": { "enum": ["CROSS_SCOPE_PROVIDER", "FRAGMENTED_FOREIGN_SURFACE", "ISOLATED_INTERNAL_PROVIDER", "NARROWER_CONSUMER_SCOPE"] },
        "primary_module": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        "related_modules": {
          "type": "array",
          "items": { "$ref": "urn:fortress:schema:v2:module-contract#/$defs/stable_id" },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "reasoning": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "declared_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/declared-dependency-evidence" }
        },
        "observed_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation-provenance" }
        },
        "candidate_structural_scope": {
          "oneOf": [
            { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
            { "type": "null" }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic-provenance" },
          "uniqueItems": true
        },
        "fingerprint": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" }
      }
    },
    "declared-dependency-evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "provider", "capabilities", "provenance"],
      "properties": {
        "consumer": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        "provider": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:fortress:schema:v2:module-contract#/$defs/stable_id" },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic-provenance" },
          "uniqueItems": true
        }
      }
    },
    "observation-provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_module", "reference", "location", "resolved_target"],
      "properties": {
        "source_path": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" },
        "source_module": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
        "reference": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "column"],
          "properties": {
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 }
          }
        },
        "resolved_target": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "diagnostic-provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path", "location"],
      "properties": {
        "authority": { "enum": ["contract", "filesystem", "source"] },
        "path": { "$ref": "urn:fortress:schema:v1:common#/$defs/relative-path" },
        "location": { "type": "string", "minLength": 1 }
      }
    }
  }
}
