{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:snapshot-audit",
  "title": "Fortress deterministic snapshot audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "standard", "snapshot_fingerprint", "repository_content_fingerprint", "outcome", "summary", "rules", "findings"],
  "properties": {
    "schema_version": { "$ref": "urn:fortress:schema:v1:common#/$defs/schema-version" },
    "project_id": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "status"],
      "properties": {
        "edition": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "candidate", "released"] }
      }
    },
    "snapshot_fingerprint": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" },
    "repository_content_fingerprint": { "$ref": "urn:fortress:schema:v1:common#/$defs/sha256" },
    "outcome": { "enum": ["PASS", "FAIL"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_evaluated", "passed", "failed", "unsupported"],
      "properties": {
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "state", "applicable", "findings", "detail"],
        "properties": {
          "rule_id": { "$ref": "urn:fortress:schema:v1:common#/$defs/rule-id" },
          "state": { "enum": ["PASSED", "FAILED", "UNSUPPORTED"] },
          "applicable": { "type": "boolean" },
          "findings": { "type": "integer", "minimum": 0 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "urn:fortress:schema:v1:snapshot-finding" }
    }
  }
}
