{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortress:schema:v1:module-contract",
  "title": "Fortress Module contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "display_name", "relationships"],
  "properties": {
    "$schema": { "const": "urn:fortress:schema:v1:module-contract" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
    "display_name": { "$ref": "urn:fortress:schema:v1:common#/$defs/non-empty-string" },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "types"],
        "properties": {
          "target": { "$ref": "urn:fortress:schema:v1:common#/$defs/stable-id" },
          "types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["depends_on", "verifies"] }
          }
        }
      }
    }
  }
}
