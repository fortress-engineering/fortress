  "features": [
    {
      "id": "AF-ARCHITECTURE-EVALUATION-0001",
      "version": "0.1.0",
      "requirements": [
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R01",
          "statement": "Architecture Evaluation consumes the canonical CCG Module and dependency facts to derive architecture and physical ownership views without owning or rebuilding contract resolution.",
          "tests": [
            "T-AF-ARCHITECTURE-EVALUATION-0001-R01-001"
          ]
        },
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R02",
          "statement": "The ARCH-DEPENDENCY-001 evaluator deterministically reports cycles in the Module graph derived from required capabilities.",
          "tests": [
            "T-AF-ARCHITECTURE-EVALUATION-0001-R02-001",
            "T-ARCH-DEPENDENCY-001-R01-001",
            "T-ARCH-DEPENDENCY-001-R01-002",
            "T-ARCH-DEPENDENCY-001-R01-003"
          ]
        },
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R03",
          "statement": "ARCH-REALIZATION-001 deterministically reconciles independently observed direct Rust Module dependencies with CCG direct authorization, hard-fails undeclared and transitive-bypass access, and keeps declared-unobserved, external, unresolved, unsupported, and capability-realization states truthful.",
          "tests": [
            "T-AF-ARCHITECTURE-EVALUATION-0001-R03-001",
            "T-ARCH-REALIZATION-001-R01-001",
            "T-ARCH-REALIZATION-001-R01-002",
            "T-ARCH-REALIZATION-001-R01-003",
            "T-ARCH-REALIZATION-001-R01-004"
          ]
        },
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R04",
          "statement": "Architecture Evaluation deterministically derives non-normative architecture diagnostics from canonical CCG containment and dependency facts plus independently observed realization while separating evidence-backed structural opportunities from rule violations.",
          "tests": [
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-001",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-002",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-003",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-004",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-005",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R04-006"
          ]
        },
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R05",
          "statement": "Module Contract v3 declares explicit capability/effect allow and deny authority while v2 contracts remain loadable with semantic policy truthfully UNDECLARED.",
          "tests": [
            "T-AF-ARCHITECTURE-EVALUATION-0001-R05-001",
            "T-AF-ARCHITECTURE-EVALUATION-0001-R05-002"
          ]
        },
        {
          "id": "AF-ARCHITECTURE-EVALUATION-0001-R06",
          "statement": "ARCH-SEMANTIC-001 deterministically reconciles declared Module semantic policy with direct and transitive State/Effect evidence, preserves claim-relative uncertainty, emits causal canonical findings, excludes analysis-only territories, and scales by indexed Module ownership.",
          "tests": [
            "T-ARCH-SEMANTIC-001-R01-001",
            "T-ARCH-SEMANTIC-001-R01-002",
            "T-ARCH-SEMANTIC-001-R01-003",
            "T-ARCH-SEMANTIC-001-R01-004"
          ]
        }
      ]
    }
  ],
  "behavior": [
    {
      "id": "CHK-ARCHITECTURE-EVALUATED",
      "feature": "AF-FORTRESS-AUDIT-0001",
      "kind": "action",
      "transitions": [
