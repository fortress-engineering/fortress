{
  "$schema": "../../schemas/v1/architecture.schema.json",
  "schema_version": 1,
  "zones": [
    "normative",
    "core",
    "presentation",
    "governance",
    "evidence"
  ],
  "components": [
    {
      "id": "AF-STANDARD-AUTHORITY-0001",
      "title": "Standard and schema authority",
      "zone": "normative",
      "paths": [
        "standard/",
        "schemas/",
        "docs/standard/"
      ],
      "depends_on": []
    },
    {
      "id": "AF-CORE-0001",
      "title": "Provider-independent Fortress core",
      "zone": "core",
      "paths": [
        "crates/fortress-core/"
      ],
      "depends_on": [
        "AF-STANDARD-AUTHORITY-0001"
      ]
    },
    {
      "id": "TF-CLI-0001",
      "title": "Native command-line presentation",
      "zone": "presentation",
      "paths": [
        "crates/fortress-cli/"
      ],
      "depends_on": [
        "AF-CORE-0001"
      ]
    },
    {
      "id": "AF-BOOTSTRAP-GOVERNANCE-0001",
      "title": "Fortress self-governance declarations",
      "zone": "governance",
      "paths": [
        ".fortress/",
        "docs/governance/",
        "docs/decisions/",
        "docs/history/"
      ],
      "depends_on": [
        "AF-STANDARD-AUTHORITY-0001"
      ]
    },
    {
      "id": "AF-CONFORMANCE-0001",
      "title": "Rule and implementation evidence",
      "zone": "evidence",
      "paths": [
        "conformance/",
        "tests/"
      ],
      "depends_on": [
        "AF-STANDARD-AUTHORITY-0001",
        "AF-CORE-0001"
      ]
    },
    {
      "id": "AF-REPOSITORY-GOVERNANCE-0001",
      "title": "Repository-wide structure and development authority",
      "zone": "governance",
      "paths": [
        ".github/",
        "docs/README.md",
        "docs/architecture/",
        "docs/certification/",
        "docs/development/",
        "docs/onboarding/",
        "docs/product/"
      ],
      "depends_on": [
        "AF-STANDARD-AUTHORITY-0001"
      ]
    }
  ],
  "repository_artifacts": [
    {
      "path": ".gitignore",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "AGENTS.md",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "Cargo.lock",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "generated",
      "required": true
    },
    {
      "path": "Cargo.toml",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "CONTRIBUTING.md",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "GOVERNANCE.md",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "README.md",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "rust-toolchain.toml",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    },
    {
      "path": "SECURITY.md",
      "owner": "AF-REPOSITORY-GOVERNANCE-0001",
      "classification": "repository-metadata",
      "required": true
    }
  ],
  "repository_structure": {
    "allowed_top_level": [
      ".fortress",
      ".github",
      "conformance",
      "crates",
      "docs",
      "schemas",
      "standard",
      "tests"
    ],
    "source_roots": [
      "crates/",
      "schemas/",
      "standard/"
    ],
    "prohibited_artifact_classes_in_source": [
      "generated",
      "runtime-state"
    ],
    "canonical_paths": [
      ".fortress/architecture/architecture.json",
      ".fortress/project.json",
      "standard/drafts/1.0.0/manifest.json"
    ]
  }
}
