  "review_findings": [
    {
      "id": "statement-macro-omission",
      "disposition": "CONFIRMED_FIXED_CONSERVATIVELY",
      "tests": [
        "qualification_corpus_replays_authored_cases"
      ],
      "note": "Statement-position macro invocation previously escaped call resolution and falsely passed a deny claim. It now creates an unsupported opaque call and UNKNOWN claim."
    },
    {
      "id": "mixed-witness-order",
      "disposition": "CONFIRMED_FIXED",
      "tests": [
        "shared_operation_site_retains_production_support_and_both_causal_paths"
      ],
      "note": "One canonical operation-site finding is blocking when any retained path is production-capable; the same site identity and eligibility survive source-order permutation."
    },
    {
      "id": "coverage-loss-retirement",
      "disposition": "CONFIRMED_TEMPORARILY_REFUSED",
      "tests": [
        "coverage_loss_is_not_resolution_without_comparable_retirement_evidence",
        "raw_audit_failure_remains_distinct_from_progressive_check_success"
      ],
      "note": "Legacy prune has no comparable coverage or authority input and refuses mutation. Transition-based retirement belongs to later governance work."
    },
    {
      "id": "explicit-drop",
      "disposition": "CONFIRMED_FIXED_CONSERVATIVELY",
      "tests": [
        "destructor_unchecked_unwrap_and_open_options_do_not_gain_false_purity"
      ],
      "note": "Explicit std::mem::drop is unsupported with uncertainty and possible external effects; no destructor purity is inferred."
    },
    {
      "id": "unchecked-unwrap",
      "disposition": "CONFIRMED_FIXED",
      "tests": [
        "destructor_unchecked_unwrap_and_open_options_do_not_gain_false_purity"
      ],
      "note": "Exact Option/Result unchecked unwrap operations imply unsafe execution rather than a panic claim."
    },
    {
      "id": "open-options",
      "disposition": "SUPPORTED_BOUNDARY_LIMITATION",
      "tests": [
        "destructor_unchecked_unwrap_and_open_options_do_not_gain_false_purity"
      ],
      "note": "OpenOptions::new is unsupported and chained open unresolved; option-sensitive read/write effects are not claimed."
    },
    {
      "id": "user-method-spelling",
      "disposition": "DISPROVED_BY_CONTROL",
      "tests": [
        "unresolved_method_names_never_gain_refined_specificity"
      ],
      "note": "Unrelated user write/spawn/drop/unwrap names do not acquire standard operation effects."
    },
    {
      "id": "implicit-drop",
      "disposition": "SUPPORTED_BOUNDARY_LIMITATION",
      "tests": [
        "destructor_unchecked_unwrap_and_open_options_do_not_gain_false_purity"
      ],
      "note": "Implicit scope-end destructor propagation is not yet modeled; negative claims involving it remain outside the qualified semantic envelope."
    },
    {
      "id": "shadowed-capability-policy",
      "disposition": "CONFIRMED_PENDING_CLAIMS",
      "tests": [
        "shadowed_policy_empty_claim_is_reproduced_for_effective_policy_work"
      ],
      "note": "The current evaluator emits an empty PASS for a capability restriction whose only observation is assigned to a more specific effect restriction. This is a reproduced defect, not a passing negative claim; effective-policy truth tables belong to the dependent claim-algebra work."
    },
    {
      "id": "omitted-operation-record",
      "disposition": "SUPPORTED_BOUNDARY_LIMITATION",
      "tests": [],
      "note": "Calls absent before PSM construction lack an independent syntax inventory; no dropped-operation detection is claimed."
    },
    {
      "id": "callback-generic-operation",
      "disposition": "SUPPORTED_BOUNDARY_LIMITATION",
      "tests": [
        "residual_calls_distinguish_trait_objects_generics_external_and_unknown_receivers"
      ],
      "note": "Dynamic/generic receiver effects remain explicit uncertainty rather than resolved standard effects."
    }
  ],
